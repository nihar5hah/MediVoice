{
  "name": "clinical-voice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "supabase:verify": "tsx scripts/verify-supabase.ts",
    "vapi:setup": "tsx scripts/setup-vapi.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "dotenv": "^17.4.2",
    "express": "latest",
    "nanoid": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.14.2",
    "tsx": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
